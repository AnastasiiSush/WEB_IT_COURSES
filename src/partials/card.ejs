<article class="card">
  <div class="card__body">
    <div class="card__meta">
      <span class="card__label"><%= course.level %></span>
      <span class="card__note"><%= course.duration %></span>
    </div>

    <h3 class="card__title"><%= course.title %></h3>
    <p class="card__text"><%= course.description %></p>

    <% if (course.tags && course.tags.length) { %>
    <ul class="card__tags" aria-label="Tags">
      <% course.tags.forEach(function (tag) { %>
      <li class="card__tag"><%= tag %></li>
      <% }); %>
    </ul>
    <% } %>

    <div class="card__footer">
      <span class="card__price"><%= course.price %></span>
      <a class="button button--primary button--sm" href="<%= course.link || 'details.html' %>">
        Learn More<span class="visually-hidden"> about <%= course.title %></span>
      </a>
    </div>
  </div>
</article>
